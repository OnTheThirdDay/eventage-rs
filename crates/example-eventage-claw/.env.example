# Copy to .env and fill in values before running docker compose.
# No config.toml needed — everything is configured here.

# ── LLM credentials ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ── Groups ────────────────────────────────────────────────────────────────────
# Comma-separated list of group names. First is main (admin). Each gets isolated
# memory, tasks, and conversation history.
CLAW_GROUPS=personal
# Multi-user example:
# CLAW_GROUPS=personal,alice,bob

# ── Data directory on the host machine ───────────────────────────────────────
BRIDGE_AUTH_DIR=/opt/claw/bridge-auth # Baileys WhatsApp session

# ── WhatsApp bridge ───────────────────────────────────────────────────────────
CLAW_GROUP=personal       # default group for unknown senders
# Route each sender's phone number to their group (no separate bridge needed):
# SENDER_MAP=61400000000:alice,61411111111:bob
# TRIGGER_PREFIX=!          # only forward messages starting with !
# PAIRING_CODE=+1234567890  # use pairing-code auth instead of QR scan
# SELF_CHAT=false
